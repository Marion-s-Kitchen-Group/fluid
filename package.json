    "@tanem/react-nprogress": "^6.0.3",
    "@vercel/stega": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "color2k": "^2.0.4",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "graphql": "^16.13.1",
